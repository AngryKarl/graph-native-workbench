{
  "name": "@graph-workbench/repository",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint apps packages packs scripts tests eslint.config.js playwright.config.ts vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm workbench:build && playwright test",
    "perf:check": "tsx scripts/performance-baseline.ts",
    "graph-workbench": "tsx apps/cli/src/main.ts",
    "demo": "tsx apps/cli/src/main.ts demo",
    "demo:pause": "tsx apps/cli/src/main.ts demo --pause",
    "demo:architecture": "tsx apps/cli/src/main.ts pack demo packs/architecture/src/index.ts --fixture street_renewal",
    "workbench": "concurrently -k -n api,web -c blue,green \"pnpm --filter @graph-workbench/workbench dev:api\" \"pnpm --filter @graph-workbench/workbench dev:web\"",
    "workbench:build": "pnpm --filter @graph-workbench/workbench build:web",
    "dist:build": "pnpm workbench:build && node scripts/build-distribution.mjs",
    "dist:check": "pnpm dist:build && node scripts/check-distribution.mjs",
    "dist:pack": "pnpm dist:check && node scripts/pack-distribution.mjs",
    "release:check": "pnpm typecheck && pnpm lint && pnpm test && pnpm perf:check && pnpm test:e2e && pnpm dist:pack && node scripts/check-clean-install.mjs && node scripts/check-release-readiness.mjs",
    "pack:validate": "tsx apps/cli/src/main.ts pack validate",
    "pack:inspect": "tsx apps/cli/src/main.ts pack inspect"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@eslint/js": "^10.0.1",
    "@graph-workbench/connector-github": "workspace:*",
    "@graph-workbench/contracts": "workspace:*",
    "@graph-workbench/core": "workspace:*",
    "@graph-workbench/pack-architecture": "workspace:*",
    "@graph-workbench/pack-customer-success": "workspace:*",
    "@graph-workbench/pack-cybersecurity-response": "workspace:*",
    "@graph-workbench/pack-data-mlops": "workspace:*",
    "@graph-workbench/pack-healthcare-diagnostics": "workspace:*",
    "@graph-workbench/pack-quantitative-finance": "workspace:*",
    "@graph-workbench/pack-research": "workspace:*",
    "@graph-workbench/pack-robotics-fleet": "workspace:*",
    "@graph-workbench/pack-sdk": "workspace:*",
    "@graph-workbench/pack-software-delivery": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.21.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "fflate": "^0.8.2",
    "globals": "^17.11.0",
    "pg-boss": "^12.27.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.0.0"
  }
}
