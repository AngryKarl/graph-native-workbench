{
  "name": "@graphwork/repository",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm workbench:build && playwright test",
    "perf:check": "tsx scripts/performance-baseline.ts",
    "graphwork": "tsx apps/cli/src/main.ts",
    "demo": "tsx apps/cli/src/main.ts demo",
    "demo:pause": "tsx apps/cli/src/main.ts demo --pause",
    "demo:architecture": "tsx apps/cli/src/main.ts pack demo packs/architecture/src/index.ts --fixture street_renewal",
    "workbench": "concurrently -k -n api,web -c blue,green \"pnpm --filter @graphwork/workbench dev:api\" \"pnpm --filter @graphwork/workbench dev:web\"",
    "workbench:build": "pnpm --filter @graphwork/workbench build:web",
    "dist:build": "pnpm workbench:build && node scripts/build-distribution.mjs",
    "dist:check": "pnpm dist:build && node scripts/check-distribution.mjs",
    "dist:pack": "pnpm dist:check && node scripts/pack-distribution.mjs",
    "release:check": "pnpm typecheck && pnpm test && pnpm perf:check && pnpm test:e2e && pnpm dist:pack && node scripts/check-clean-install.mjs && node scripts/check-release-readiness.mjs",
    "pack:validate": "tsx apps/cli/src/main.ts pack validate",
    "pack:inspect": "tsx apps/cli/src/main.ts pack inspect"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@graphwork/contracts": "workspace:*",
    "@graphwork/core": "workspace:*",
    "@graphwork/pack-architecture": "workspace:*",
    "@graphwork/pack-customer-success": "workspace:*",
    "@graphwork/pack-research": "workspace:*",
    "@graphwork/pack-sdk": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.20.4",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.0",
    "pg-boss": "^12.27.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
